{
  "name": "praktijkannemieke",
  "private": true,
  "description": "Statische site Praktijk Annemieke – tests en tooling",
  "scripts": {
    "start": "node scripts/static-server.mjs",
    "test": "playwright test",
    "test:update-snapshots": "playwright test tests/visual.spec.js --update-snapshots",
    "test:visual": "playwright test tests/visual.spec.js",
    "test:links": "playwright test tests/links.spec.js",
    "test:navigation": "playwright test tests/navigation-mobile.spec.js tests/navigation-desktop.spec.js",
    "test:external": "playwright test tests/external-requests.spec.js",
    "test:a11y": "playwright test tests/a11y.spec.js",
    "test:html": "playwright test tests/html-validate.spec.js",
    "test:lighthouse": "playwright test tests/lighthouse.spec.js --project=lighthouse",
    "paths:fix": "node scripts/sanitize-filenames.mjs && node scripts/make-paths-relative.mjs",
    "migrate:assets": "node scripts/migrate-to-assets.mjs",
    "semantic:html": "node scripts/apply-semantic-html.mjs",
    "docs:links": "node scripts/fix-doc-links.mjs",
    "fonts:link": "node scripts/link-local-fonts.mjs",
    "fonts:woff2": "node scripts/convert-fonts-to-woff2.mjs",
    "clean:head": "node scripts/clean-html-head.mjs",
    "lighthouse:fix": "node scripts/apply-lighthouse-fixes.mjs",
    "finalize:site": "node scripts/finalize-static-site.mjs",
    "seo:jsonld": "node scripts/fix-json-ld-urls.mjs",
    "seo:static": "node scripts/apply-seo-static.mjs",
    "fix:headings": "node scripts/fix-heading-hierarchy.mjs",
    "assets:rename": "node scripts/rename-bronexport-assets.mjs",
    "scrub:bronexport": "node scripts/scrub-bronexport-remnants.mjs",
    "scrub:cms-markup": "node scripts/scrub-cms-markup.mjs",
    "css:build": "node scripts/build-site-css.mjs",
    "css:migrate": "node scripts/apply-site-stylesheets.mjs",
    "css:site": "node scripts/build-site-css.mjs && node scripts/apply-site-stylesheets.mjs",
    "css:layout": "node scripts/build-layout-css.mjs && node scripts/apply-layout-stylesheet.mjs",
    "css:shell": "node scripts/apply-shell-classes.mjs",
    "css:normalize": "node scripts/normalize-page-markup.mjs && node scripts/apply-current-menu.mjs && node scripts/apply-shell-classes.mjs && node scripts/apply-shell-stylesheet.mjs",
    "css:a11y-slugs": "node scripts/migrate-a11y-page-ids.mjs",
    "css:rename-builder": "node scripts/rename-builder-classes.mjs",
    "css:strip-comments": "node scripts/strip-css-comments.mjs",
    "strato:links": "node scripts/apply-strato-links.mjs",
    "strato:origin": "node scripts/migrate-site-origin.mjs",
    "strato:staging-robots": "node scripts/apply-staging-robots.mjs",
    "strato:live-robots": "node scripts/apply-staging-robots.mjs live",
    "strato:prepare": "node scripts/migrate-site-origin.mjs && node scripts/apply-strato-links.mjs && node scripts/apply-staging-robots.mjs && node scripts/apply-seo-static.mjs",
    "errors:generate": "node scripts/generate-error-pages.mjs && node scripts/apply-footer-updates.mjs",
    "docs:patch-formulier": "node scripts/patch-kennismakingsformulier-docx.mjs",
    "perf:fonts": "node scripts/strip-bronexport-inline-fonts.mjs",
    "perf:images": "node scripts/optimize-lighthouse-images.mjs && node scripts/apply-webp-paths.mjs",
    "perf:markup": "node scripts/apply-perf-markup.mjs",
    "perf:lighthouse": "npm run perf:fonts && npm run perf:images && npm run perf:markup"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "html-validate": "^9.4.0",
    "jszip": "^3.10.2",
    "lighthouse": "^12.3.0",
    "playwright-lighthouse": "^4.0.0",
    "serve": "^14.2.4",
    "sharp": "^0.35.5",
    "ttf2woff2": "^8.0.1"
  }
}
