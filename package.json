{
  "name": "praktijkannemieke",
  "private": true,
  "description": "Statische site Praktijk Annemieke – tests en tooling",
  "scripts": {
    "start": "node scripts/static-server.mjs",
    "test": "playwright test",
    "test:update-snapshots": "playwright test tests/visual.spec.js --update-snapshots",
    "test:visual": "playwright test tests/visual.spec.js",
    "test:links": "playwright test tests/links.spec.js",
    "test:navigation": "playwright test tests/navigation-mobile.spec.js tests/navigation-desktop.spec.js",
    "test:external": "playwright test tests/external-requests.spec.js",
    "test:a11y": "playwright test tests/a11y.spec.js",
    "test:html": "playwright test tests/html-validate.spec.js",
    "test:lighthouse": "playwright test tests/lighthouse.spec.js",
    "paths:fix": "node scripts/sanitize-filenames.mjs && node scripts/make-paths-relative.mjs",
    "migrate:assets": "node scripts/migrate-to-assets.mjs",
    "semantic:html": "node scripts/apply-semantic-html.mjs",
    "docs:links": "node scripts/fix-doc-links.mjs",
    "fonts:link": "node scripts/link-local-fonts.mjs",
    "fonts:woff2": "node scripts/convert-fonts-to-woff2.mjs",
    "clean:head": "node scripts/clean-html-head.mjs",
    "lighthouse:fix": "node scripts/apply-lighthouse-fixes.mjs",
    "finalize:site": "node scripts/finalize-static-site.mjs",
    "seo:jsonld": "node scripts/fix-json-ld-urls.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "html-validate": "^9.4.0",
    "lighthouse": "^12.3.0",
    "playwright-lighthouse": "^4.0.0",
    "serve": "^14.2.4",
    "ttf2woff2": "^8.0.1"
  }
}
