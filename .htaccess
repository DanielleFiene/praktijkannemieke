# Praktijk Annemieke — Strato/Apache (mod_rewrite)
DirectoryIndex index.html

RewriteEngine On

# === TIJDELIJK: SSL nog niet actief — geen http→https (na SSL: blok hieronder weer aan, http-regels hier terug naar https) ===
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://praktijkannemieke.nl%{REQUEST_URI} [R=301,L,NE]

# === WWW-KEUZE: apex zonder www (http tot SSL actief) ===
RewriteCond %{HTTP_HOST} ^www\.praktijkannemieke\.nl$ [NC]
RewriteRule ^ http://praktijkannemieke.nl%{REQUEST_URI} [R=301,L,NE]
# === einde WWW-KEUZE ===

# Oude WordPress-URL
RedirectMatch 301 (?i)^/ondersteunende-middelen-2/?$ http://praktijkannemieke.nl/ondersteunende-middelen/

# Trailing slash (geen bestanden met extensie)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,6}$
RewriteRule ^(.+)$ http://praktijkannemieke.nl/$1/ [R=301,L,NE]

ErrorDocument 404 /404.html