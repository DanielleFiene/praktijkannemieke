# Praktijk Annemieke — Strato/Apache (mod_rewrite)
DirectoryIndex index.html

RewriteEngine On

# === HTTPS afdwingen ===
RewriteCond %{HTTPS} off
RewriteRule ^ https://praktijkannemieke.nl%{REQUEST_URI} [R=301,L,NE]

# === WWW-KEUZE: apex zonder www ===
RewriteCond %{HTTP_HOST} ^www\.praktijkannemieke\.nl$ [NC]
RewriteRule ^ https://praktijkannemieke.nl%{REQUEST_URI} [R=301,L,NE]
# === einde WWW-KEUZE ===

# Oude WordPress-URL
RedirectMatch 301 (?i)^/ondersteunende-middelen-2/?$ https://praktijkannemieke.nl/ondersteunende-middelen/

# Trailing slash (geen bestanden met extensie)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,6}$
RewriteRule ^(.+)$ https://praktijkannemieke.nl/$1/ [R=301,L,NE]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
	Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType text/css "access plus 1 year"
	ExpiresByType application/javascript "access plus 1 year"
	ExpiresByType image/webp "access plus 1 year"
	ExpiresByType image/png "access plus 1 year"
	ExpiresByType image/jpeg "access plus 1 year"
	ExpiresByType image/svg+xml "access plus 1 year"
	ExpiresByType font/woff2 "access plus 1 year"
</IfModule>