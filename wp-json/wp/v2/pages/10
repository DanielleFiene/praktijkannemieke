ion=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; background_image=&#8221;https:\/\/praktijkannemieke.nl\/site\/wp-content\/uploads\/2021\/07\/home-annemieke.jpg&#8221; bottom_divider_color=&#8221;#FFFFFF&#8221; bottom_divider_height=&#8221;203px&#8221; bottom_divider_repeat=&#8221;1x&#8221; bottom_divider_flip=&#8221;horizontal&#8221; border_radii=&#8221;off|||200px|&#8221; global_colors_info=&#8221;{}&#8221;][et_pb_fullwidth_header title=&#8221;\u2018Our life is the creation of our mind\u2019&#8221; button_one_text=&#8221;Neem contact op&#8221; button_one_url=&#8221;https:\/\/www.praktijkannemieke.nl\/neem-contact-op\/&#8221; content_max_width=&#8221;75%&#8221; _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; title_font=&#8221;|600|||||||&#8221; title_font_size=&#8221;51px&#8221; background_enable_color=&#8221;off&#8221; background_enable_image=&#8221;off&#8221; custom_button_one=&#8221;on&#8221; button_one_border_color=&#8221;#FFFFFF&#8221; button_one_use_icon=&#8221;off&#8221; height=&#8221;688px&#8221; custom_margin=&#8221;||||false|false&#8221; custom_padding=&#8221;|0px|||false|false&#8221; global_colors_info=&#8221;{}&#8221; button_one_border_width__hover_enabled=&#8221;on|hover&#8221; button_one_border_color__hover_enabled=&#8221;on|hover&#8221; button_one_border_radius__hover_enabled=&#8221;on|hover&#8221; button_one_border_color__hover=&#8221;#FFFFFF&#8221;][\/et_pb_fullwidth_header][\/et_pb_section][et_pb_section fb_built=&#8221;1&#8243; module_id=&#8221;Nei&#8221; module_class=&#8221;Nei&#8221; _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; global_colors_info=&#8221;{}&#8221;][et_pb_row _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; global_colors_info=&#8221;{}&#8221;][et_pb_column type=&#8221;4_4&#8243; _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; global_colors_info=&#8221;{}&#8221;][et_pb_text _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; header_font=&#8221;||||||||&#8221; header_text_color=&#8221;#c1dfe0&#8243; header_font_size=&#8221;65px&#8221; global_colors_info=&#8221;{}&#8221;]<\/p>\n<h1 style=\"text-align: center;\">NEI<\/h1>\n<p>[\/et_pb_text][\/et_pb_column][\/et_pb_row][et_pb_row column_structure=&#8221;1_2,1_2&#8243; _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; global_colors_info=&#8221;{}&#8221;][et_pb_column type=&#8221;1_2&#8243; _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; global_colors_info=&#8221;{}&#8221;][et_pb_text _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; header_font=&#8221;|600|||||||&#8221; header_font_size=&#8221;65px&#8221; header_3_font_size=&#8221;50px&#8221; global_colors_info=&#8221;{}&#8221;]<\/p>\n<h3>Wat is NEI?<\/h3>\n<p>NEI staat voor Neuro Emotionele Integratie, wat wil zeggen dat je oude emoties gaat verwerken.<\/p>\n<p>NEI werkt met het onderbewuste. In het onderbewuste liggen alle emoties opgeslagen die ooit zijn gevoeld en ervaren. Die emoties bepalen hoe jij je voelt, hoe je je gedraagt en hoe je functioneert. Als er onverwerkte emoties zijn, zorgen deze voor lichamelijke of geestelijke klachten.<\/p>\n<p>[\/et_pb_text][et_pb_text _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; header_font=&#8221;||||||||&#8221; header_font_size=&#8221;65px&#8221; header_3_font_size=&#8221;50px&#8221; global_colors_info=&#8221;{}&#8221;]<\/p>\n<h3>Wat kan zo\u2019n emotie met je doen?<\/h3>\n<p>Een onverwerkte emotie vraagt aandacht door prikkels af te geven. Maar in onze maatschappij en ons drukke leven staan we nagenoeg nooit stil bij wat we voelen en wat dat ons wil zeggen. Het gevolg is dat zo\u2019n emotie een steeds sterkere prikkel geeft. En voor de \u00e9\u00e9n betekent dat dat er een rugpijn ontstaat, en voor de ander betekent het een naar gevoel, bijvoorbeeld angst of verdriet. Hoe langer we het negeren, hoe sterker de prikkel en dus de klacht wordt.<\/p>\n<p>[\/et_pb_text][\/et_pb_column][et_pb_column type=&#8221;1_2&#8243; _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; global_colors_info=&#8221;{}&#8221;][et_pb_text _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; header_font=&#8221;||||||||&#8221; header_font_size=&#8221;65px&#8221; header_3_font_size=&#8221;50px&#8221; global_colors_info=&#8221;{}&#8221;]<\/p>\n<h3>Hoe werkt een NEI behandeling?<\/h3>\n<p>Met behulp van een biotensor, een instrument waarmee ik energie meet, gaan we op zoek naar de onverwerkte emotie die de klacht veroorzaakt.<\/p>\n<p>Nadat we alles uitgezocht en helder hebben, kan je onderbewuste deze informatie via een effectieve integratietechniek verwerken en een beweging in gang zetten. De emotie is op dat moment ontstoort en past weer bij jouw eigen energie. Vaak al in 1 behandeling.<\/p>\n<p>Het mooie van NEI is dat je geen lange praatsessies nodig hebt. Je hoeft niet alles opnieuw te beleven of te vertellen. Hierdoor is het een hele vriendelijke behandelmethode, die ook op afstand gedaan kan worden.<\/p>\n<p>[\/et_pb_text][et_pb_text _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; header_font=&#8221;||||||||&#8221; header_font_size=&#8221;65px&#8221; header_3_font_size=&#8221;50px&#8221; global_colors_info=&#8221;{}&#8221;]<\/p>\n<h3>Voor wie is NEI?<\/h3>\n<p>NEI is voor iedereen. Van baby\u2019s die nog in de baarmoeder zitten, tot het einde van iemands leven en alles daar tussenin. Doordat we in het onderbewuste werken krijgen we de antwoorden die nodig zijn via diverse protocollen. We hoeven dus geen fysieke antwoorden te horen. Daarmee kunnen we bijvoorbeeld een stuitligging van een baby draaien, omdat de baby nog in de baarmoeder kan \u2018vertellen\u2019 wat er is. Nadat het gehoord is kan deze in de juiste positie gaan liggen en hoef jij als aanstaande moeder geen pijnlijke versie in het ziekenhuis.<\/p>\n<p>[\/et_pb_text][\/et_pb_column][\/et_pb_row][\/et_pb_section][et_pb_section fb_built=&#8221;1&#8243; fullwidth=&#8221;on&#8221; _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; global_colors_info=&#8221;{}&#8221;][et_pb_fullwidth_header button_one_text=&#8221;Lees ervaringen&#8221; button_one_url=&#8221;https:\/\/www.praktijkannemieke.nl\/over-annemieke\/#Ervaringen&#8221; _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; title_font_size=&#8221;65px&#8221; use_background_color_gradient=&#8221;on&#8221; background_color_gradient_direction=&#8221;270deg&#8221; background_color_gradient_stops=&#8221;rgba(193,223,224,0) 44%|rgba(242,201,205,0.8) 66%&#8221; background_color_gradient_overlays_image=&#8221;on&#8221; background_color_gradient_start=&#8221;rgba(193,223,224,0)&#8221; background_color_gradient_start_position=&#8221;44%&#8221; background_color_gradient_end=&#8221;rgba(242,201,205,0.8)&#8221; background_color_gradient_end_position=&#8221;66%&#8221; background_image=&#8221;https:\/\/praktijkannemieke.nl\/site\/wp-content\/uploads\/2021\/07\/NEI-biotensor-1.jpg&#8221; custom_button_one=&#8221;on&#8221; button_one_border_color=&#8221;#FFFFFF&#8221; button_one_border_radius=&#8221;2px&#8221; button_one_use_icon=&#8221;off&#8221; height=&#8221;620px&#8221; background_last_edited=&#8221;on|desktop&#8221; use_background_color_gradient_phone=&#8221;on&#8221; background_color_gradient_stops_tablet=&#8221;rgba(193,223,224,0) 18%|rgba(242,201,205,0.8) 37%&#8221; background_color_gradient_stops_phone=&#8221;rgba(193,223,224,0) 0%|rgba(242,201,205,0.78) 0%&#8221; background_color_gradient_start_position_tablet=&#8221;18%&#8221; background_color_gradient_start_position_phone=&#8221;0%&#8221; background_color_gradient_end_phone=&#8221;rgba(242,201,205,0.78)&#8221; background_color_gradient_end_position_tablet=&#8221;37%&#8221; background_color_gradient_end_position_phone=&#8221;0%&#8221; global_colors_info=&#8221;{}&#8221; button_one_bg_color__hover_enabled=&#8221;on|hover&#8221;]<\/p>\n<h1>&#8220;&#8221;Ik geef je de tools om te<br \/>ontdekken dat alle<br \/>mogelijkheden in jou<br \/>zitten&#8221;&#8221;<\/h1>\n<p>[\/et_pb_fullwidth_header][\/et_pb_section][et_pb_section fb_built=&#8221;1&#8243; module_id=&#8221;Wie&#8221; module_class=&#8221;Wie&#8221; _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; background_color=&#8221;#c1dfe0&#8243; global_colors_info=&#8221;{}&#8221;][et_pb_row _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; global_colors_info=&#8221;{}&#8221;][et_pb_column type=&#8221;4_4&#8243; _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; global_colors_info=&#8221;{}&#8221;][et_pb_text _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; header_font_size=&#8221;65px&#8221; global_colors_info=&#8221;{}&#8221;]<\/p>\n<h1 id=\"u5484-2\" style=\"text-align: center;\"><span class=\"H1-Jenna-Sue-56pt-zwart\" id=\"u5484\">Voor wie is NEI geschikt<\/span><\/h1>\n<h2 id=\"u5484-4\" style=\"text-align: center;\"><span style=\"color: #ffffff;\">NEI is voor iedereen. Een paar voorbeelden waarbij NEI een geschikte <br \/>behandelmethode is:<\/span><\/h2>\n<p>[\/et_pb_text][\/et_pb_column][\/et_pb_row][et_pb_row column_structure=&#8221;1_2,1_2&#8243; _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; global_colors_info=&#8221;{}&#8221;][et_pb_column type=&#8221;1_2&#8243; _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; global_colors_info=&#8221;{}&#8221;][et_pb_text _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; global_colors_info=&#8221;{}&#8221;]<\/p>\n<h4 id=\"u88942-2\"><strong><span style=\"color: #ffffff;\"><em>Emotionele klachten<\/em><\/span><\/strong><\/h4>\n<p>(Faal)angst, jaloezie, verdriet, boosheid, neerslachtigheid, enz.<\/p>\n<h4 id=\"u88942-7\"><em><strong><span style=\"color: #ffffff;\">Fysieke klachten<\/span><\/strong><\/em><\/h4>\n<p id=\"u88942-9\">Hoofdpijn, rugpijn, buikpijn, oorpijn, schildklier, eczeem, enz.<\/p>\n<h4 id=\"u88942-12\"><span style=\"color: #ffffff;\"><em><strong>Gewoonten\/verslavingen<\/strong><\/em><\/span><\/h4>\n<p id=\"u88942-14\">Roken, drank, drugs, medicijnen, nagelbijten, enz.<\/p>\n<p>[\/et_pb_text][\/et_pb_column][et_pb_column type=&#8221;1_2&#8243; _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; global_colors_info=&#8221;{}&#8221;][et_pb_text _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; global_colors_info=&#8221;{}&#8221;]<\/p>\n<h4 id=\"u88941-2\"><span style=\"color: #ffffff;\"><em><strong>Maar denk ook aan<\/strong><\/em><\/span><\/h4>\n<p id=\"u88941-4\">Niet zwanger kunnen worden<\/p>\n<p id=\"u88941-6\">Allergie\u00ebn, voedselintolerantie<\/p>\n<p id=\"u88941-8\">Slapeloosheid, vermoeidheid<\/p>\n<p id=\"u88941-10\">Gebrek aan zelfvertrouwen<\/p>\n<p id=\"u88941-12\">Niet lekker in je vel zitten<\/p>\n<p id=\"u88941-14\">Huilbaby\u2019s<\/p>\n<p id=\"u88941-16\">Migraine<\/p>\n<p id=\"u88941-18\">Rouwen<\/p>\n<p id=\"u88941-20\">Stress<\/p>\n<p id=\"u88941-22\">ADHD<\/p>\n<p>[\/et_pb_text][\/et_pb_column][\/et_pb_row][\/et_pb_section][et_pb_section fb_built=&#8221;1&#8243; disabled_on=&#8221;off|off|off&#8221; _builder_version=&#8221;4.9.7&#8243; _module_preset=&#8221;default&#8221; background_color=&#8221;#f3f9f9&#8243; custom_padding=&#8221;|3px||||&#8221; global_module=&#8221;94&#8243; saved_tabs=&#8221;all&#8221; global_colors_info=&#8221;{}&#8221;][et_pb_row column_structure=&#8221;1_4,1_4,1_4,1_4&#8243; _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; global_colors_info=&#8221;{}&#8221;][et_pb_column type=&#8221;1_4&#8243; _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; global_colors_info=&#8221;{}&#8221;][et_pb_text _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; text_font_size=&#8221;13px&#8221; header_font_size=&#8221;45px&#8221; header_3_font_size=&#8221;40px&#8221; global_colors_info=&#8221;{}&#8221;]<\/p>\n<div class=\"MenuItemLabel clearfix grpelem\" id=\"u1890-4\" data-ibe-flags=\"txtStyleSrc\" data-sizepolicy=\"fixed\" data-pintopage=\"page_fixedLeft\">\n<h3 class=\"shared_content\" data-content-guid=\"u1890-4_0_content\">Annemieke<\/h3>\n<p><a href=\"https:\/\/www.praktijkannemieke.nl\/over-annemieke\/\">Over Annemieke<\/a><\/p>\n<p><a href=\"https:\/\/www.praktijkannemieke.nl\/#Wie\">Voor wie<\/a><\/p>\n<p><a href=\"https:\/\/www.praktijkannemieke.nl\/over-annemieke\/#Ervaringen\">Ervaringen<\/a><\/p>\n<\/div>\n<p>[\/et_pb_text][et_pb_divider color=&#8221;#000000&#8243; disabled_on=&#8221;on|on|off&#8221; _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; custom_margin=&#8221;|-250px|||false|false&#8221; custom_padding=&#8221;60px||||false|false&#8221; global_colors_info=&#8221;{}&#8221;][\/et_pb_divider][et_pb_text _builder_version=&#8221;4.21.0&#8243; _module_preset=&#8221;default&#8221; text_font_size=&#8221;13px&#8221; global_colors_info=&#8221;{}&#8221;]<\/p>\n<p><a href=\"https:\/\/praktijkannemieke.nl\/site\/wp-content\/uploads\/2023\/12\/Kennismakingsformulier-NEI-coaching-en-therapie.docx\" target=\"_blank\" rel=\"noopener\">Kennismakingsformulier (Word)<\/a><\/p>\n<p><a href=\"https:\/\/praktijkannemieke.nl\/wp-content\/uploads\/2021\/06\/betalingsvoorwaarden_annemieke-10-2017.pdf\" target=\"_blank\" rel=\"noopener\">Betalingsvoorwaarden (PDF)<\/a><\/p>\n<p>[\/et_pb_text][et_pb_text disabled_on=&#8221;on|off|off&#8221; _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; text_font_size=&#8221;13px&#8221; custom_margin=&#8221;|-250px|||false|false&#8221; custom_margin_tablet=&#8221;-75px||||false|false&#8221; custom_margin_phone=&#8221;-75px|0px|||false|false&#8221; custom_margin_last_edited=&#8221;on|tablet&#8221; global_colors_info=&#8221;{}&#8221;]<\/p>\n<p><span>Belangrijk! Ik ben geen arts en stel geen diagnoses. Samen kijken we welke blokkades er zijn en kunnen we deze opruimen om de balans te herstellen. Altijd vanuit je eigen vraag en met respect voor jouw proces. Je blijft zelf verantwoordelijk voor dit proces \u00e9n je gezondheid. Ik zal dan ook nooit afraden om een arts of andere hulpverlener te raadplegen. Uiteraard is privacy gegarandeerd.<\/span><\/p>\n<p>[\/et_pb_text][\/et_pb_column][et_pb_column type=&#8221;1_4&#8243; _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; global_colors_info=&#8221;{}&#8221;][et_pb_text _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; text_font_size=&#8221;13px&#8221; header_font_size=&#8221;40px&#8221; header_3_font_size=&#8221;40px&#8221; global_colors_info=&#8221;{}&#8221;]<\/p>\n<h3 class=\"shared_content\" data-content-guid=\"u1890-4_0_content\">Wat ik doe<\/h3>\n<p><a href=\"https:\/\/www.praktijkannemieke.nl\/#Nei\">NEI-therapie<\/a><\/p>\n<p><a href=\"https:\/\/www.praktijkannemieke.nl\/shambhala-reiki\/\">Shambhala Reiki<\/a><\/p>\n<p><a href=\"https:\/\/www.praktijkannemieke.nl\/ondersteunende-middelen\/\">Ondersteunende middelen<\/a><\/p>\n<p><a href=\"https:\/\/www.praktijkannemieke.nl\/access-bars\/\">Access Bars<\/a><\/p>\n<p>[\/et_pb_text][et_pb_button button_url=&#8221;https:\/\/www.praktijkannemieke.nl\/neem-contact-op\/&#8221; button_text=&#8221;NEEM CONTACT OP&#8221; _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; custom_button=&#8221;on&#8221; button_text_size=&#8221;13px&#8221; button_border_width=&#8221;1px&#8221; button_border_color=&#8221;#f6d9db&#8221; button_font=&#8221;|600|||||||&#8221; button_use_icon=&#8221;off&#8221; custom_margin=&#8221;||||false|false&#8221; custom_padding=&#8221;10px|20px|10px|20px|false|false&#8221; global_colors_info=&#8221;{}&#8221; button_bg_color__hover_enabled=&#8221;on|desktop&#8221; button_bg_color__hover=&#8221;#FFFFFF&#8221; button_bg_enable_color__hover=&#8221;on&#8221; button_border_width__hover_enabled=&#8221;on|hover&#8221; button_border_color__hover_enabled=&#8221;on|hover&#8221; button_border_width__hover=&#8221;1px&#8221; button_border_color__hover=&#8221;#f6d9db&#8221;][\/et_pb_button][\/et_pb_column][et_pb_column type=&#8221;1_4&#8243; _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; global_colors_info=&#8221;{}&#8221;][et_pb_text _builder_version=&#8221;4.21.0&#8243; _module_preset=&#8221;default&#8221; text_font_size=&#8221;13px&#8221; header_font_size=&#8221;45px&#8221; header_3_font_size=&#8221;40px&#8221; global_colors_info=&#8221;{}&#8221;]<\/p>\n<h3 class=\"shared_content\" data-content-guid=\"u1890-4_0_content\">Werkwijze<\/h3>\n<p class=\"body\" id=\"u86998-12\"><span class=\"shared_content\" data-content-guid=\"u86998-12_0_content\">Door het<span>\u00a0<\/span><\/span><strong><a class=\"nonblock\" href=\"https:\/\/praktijkannemieke.nl\/site\/wp-content\/uploads\/2023\/12\/Kennismakingsformulier-NEI-coaching-en-therapie.docx\" data-href=\"upload:U87056\" target=\"_blank\" rel=\"noopener\">kennismakingsformulier<\/a><\/strong><span class=\"shared_content\" data-content-guid=\"u86998-12_2_content\"><span>\u00a0<\/span>in te vullen en dit te mailen naar<span> <span id=\"u2146-8\"><a href=\"mailto:welkom@praktijkannemieke.nl\">welkom@praktijkannemieke.nl<\/a><\/span><\/span><\/span><span class=\"shared_content\" data-content-guid=\"u86998-12_4_content\">, kan tijdens de eerste afspraak direct worden gestart met de hulpvraag.<\/span><\/p>\n<p class=\"body shared_content\" id=\"u86998-13\" data-content-guid=\"u86998-13_content\">\u00a0De praktijk wijst uit dat er na enkele afspraken al veel verandert in de situatie. Aan het eind van iedere sessie wordt besproken of een nieuwe afspraak wenselijk is.<\/p>\n<p class=\"body shared_content\" id=\"u86998-16\" data-content-guid=\"u86998-16_content\">\u00a0De praktijk is op alle werkdagen geopend. Avond afspraken kunnen in overleg gepland worden.<\/p>\n<p class=\"body shared_content\" id=\"u86998-19\" data-content-guid=\"u86998-19_content\">\u00a0Lees onze<span>\u00a0<\/span><strong><a class=\"nonblock\" href=\"https:\/\/praktijkannemieke.nl\/privacyverklaring\/\" data-href=\"page:U204968\"><span id=\"u86998-21\">privacyverklaring.<\/span><\/a><\/strong><\/p>\n<h3 class=\"body shared_content\" id=\"u86998-25\" data-content-guid=\"u86998-25_content\"><span class=\"H1-Jenna-Sue-56pt-zwart\" id=\"u86998-26\">Tarief<\/span><\/h3>\n<p class=\"body shared_content\" id=\"u86998-29\" data-content-guid=\"u86998-29_content\">De kosten bedragen \u20ac88,- voor een NEI sessie, \u20ac66,- voor een Reiki behandeling en \u20ac66,- voor een Access Bars behandeling.<\/p>\n<p>[\/et_pb_text][\/et_pb_column][et_pb_column type=&#8221;1_4&#8243; _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; global_colors_info=&#8221;{}&#8221;][et_pb_text _builder_version=&#8221;4.16&#8243; _module_preset=&#8221;default&#8221; text_font_size=&#8221;13px&#8221; global_colors_info=&#8221;{}&#8221;]<\/p>\n<p><img loading=\"lazy\" decoding=\"async\" src=\"https:\/\/praktijkannemieke.nl\/site\/wp-content\/uploads\/2021\/07\/logo-annemieke.png\" width=\"437\" height=\"323\" alt=\"\" class=\"wp-image-409 alignnone size-full\" srcset=\"https:\/\/praktijkannemieke.nl\/site\/wp-content\/uploads\/2021\/07\/logo-annemieke.png 437w, https:\/\/praktijkannemieke.nl\/site\/wp-content\/uploads\/2021\/07\/logo-annemieke-300x222.png 300w\" sizes=\"(max-width: 437px) 100vw, 437px\" \/><\/p>\n<p id=\"u2146-2\" style=\"text-align: center;\">Morelstraat 1<br \/>6658 EP Beneden-Leeuwen<\/p>\n<p style=\"text-align: center;\"><a href=\"tel:0031611260440\">T. 06 &#8211; 112 604 40<\/a><\/p>\n<p id=\"u2146-7\" style=\"text-align: center;\"><span><span id=\"u2146-8\"><a href=\"mailto:welkom@praktijkannemieke.nl\">welkom@praktijkannemieke.nl<\/a><a class=\"nonblock\" target=\"_blank\" rel=\"noopener\"><\/a><\/span><\/span><\/p>\n<p>[\/et_pb_text][et_pb_social_media_follow _builder_version=&#8