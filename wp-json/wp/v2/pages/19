\/site\/wp-content\/uploads\/2021\/06\/ondersteunendemiddelen-u121594-fr.jpg&#8221; bottom_divider_color=&#8221;#FFFFFF&#8221; bottom_divider_height=&#8221;203px&#8221; bottom_divider_repeat=&#8221;1x&#8221; bottom_divider_flip=&#8221;horizontal&#8221; border_radii=&#8221;off|||200px|&#8221;][et_pb_fullwidth_header title=&#8221;Ondersteunende middelen&#8221; text_orientation=&#8221;center&#8221; button_one_text=&#8221;Neem contact op&#8221; button_one_url=&#8221;https:\/\/www.praktijkannemieke.nl\/neem-contact-op\/&#8221; content_max_width=&#8221;75%&#8221; _builder_version=&#8221;4.9.10&#8243; _module_preset=&#8221;default&#8221; title_font=&#8221;|600|||||||&#8221; title_font_size=&#8221;51px&#8221; background_enable_color=&#8221;off&#8221; background_enable_image=&#8221;off&#8221; custom_button_one=&#8221;on&#8221; button_one_border_color=&#8221;#FFFFFF&#8221; button_one_use_icon=&#8221;off&#8221; height=&#8221;688px&#8221; custom_margin=&#8221;||||false|false&#8221; custom_padding=&#8221;|0px|||false|false&#8221; hover_enabled=&#8221;0&#8243; custom_css_title=&#8221;margin-top: 150px;&#8221; button_one_border_width__hover_enabled=&#8221;on|hover&#8221; button_one_border_color__hover_enabled=&#8221;on|hover&#8221; button_one_border_radius__hover_enabled=&#8221;on|hover&#8221; sticky_enabled=&#8221;0&#8243;][\/et_pb_fullwidth_header][\/et_pb_section][et_pb_section fb_built=&#8221;1&#8243; _builder_version=&#8221;4.9.7&#8243; _module_preset=&#8221;default&#8221;][et_pb_row _builder_version=&#8221;4.9.7&#8243; _module_preset=&#8221;default&#8221;][et_pb_column type=&#8221;4_4&#8243; _builder_version=&#8221;4.9.7&#8243; _module_preset=&#8221;default&#8221;][et_pb_text _builder_version=&#8221;4.9.7&#8243; _module_preset=&#8221;default&#8221; header_font_size=&#8221;65px&#8221;]<h1 id=\"u127761-2\" class=\"shared_content\" data-content-guid=\"u127761-2_content\" style=\"text-align: center;\"><span class=\"H1-Jenna-Sue-56pt-zwart\" id=\"u127761\">Etherische olien<\/span><\/h1>\n<p><span class=\"H1-Jenna-Sue-56pt-zwart\"><\/span><\/p>\n<p id=\"u127761-4\" class=\"shared_content\" data-content-guid=\"u127761-4_content\">In mijn praktijk en in ons dagelijks leven gebruik ik de oli\u00ebn van Young Living. Deze oli\u00ebn zijn van eerste destillatie en dus van hoogwaardige kwaliteit. Er worden geen schadelijke chemicali\u00ebn gebruikt en de gewassen zijn niet genetisch gemanipuleerd. De boerderijen zijn toegankelijk voor publiek om alles zelf te kunnen zien, van het zaadje tot aan het sealen van het flesje. Alles is in eigen beheer. Doordat de oli\u00ebn zo puur zijn, zijn de meesten ook geschikt om in te nemen.<\/p>\n<p class=\"shared_content\" data-content-guid=\"u127761-4_content\"><img loading=\"lazy\" decoding=\"async\" src=\"https:\/\/praktijkannemieke.nl\/site\/wp-content\/uploads\/2021\/06\/20170708_094236.jpg\" width=\"320\" height=\"240\" alt=\"\" class=\"wp-image-59 alignnone size-full\" srcset=\"https:\/\/praktijkannemieke.nl\/site\/wp-content\/uploads\/2021\/06\/20170708_094236.jpg 320w, https:\/\/praktijkannemieke.nl\/site\/wp-content\/uploads\/2021\/06\/20170708_094236-300x225.jpg 300w\" sizes=\"(max-width: 320px) 100vw, 320px\" \/><\/p>\n<p id=\"u127761-10\" class=\"shared_content\" data-content-guid=\"u127761-10_content\">Gebleken is dat de oli\u00ebn in sommige gevallen prima kunnen ondersteunen bij het proces na een NEI sessie. Ieder mens is anders en reageert ook anders, daarom wordt er getest welke olie het beste bij je past.<\/p>\n<p class=\"shared_content\" data-content-guid=\"u127761-4_content\">[\/et_pb_text][\/et_pb_column][\/et_pb_row][et_pb_row _builder_version=&#8221;4.9.7&#8243; _module_preset=&#8221;default&#8221; background_color=&#8221;#f6d9db&#8221; custom_padding=&#8221;50px|50px|50px|50px|true|true&#8221;][et_pb_column type=&#8221;4_4&#8243; _builder_version=&#8221;4.9.7&#8243; _module_preset=&#8221;default&#8221;][et_pb_text _builder_version=&#8221;4.9.7&#8243; _module_preset=&#8221;default&#8221; header_font_size=&#8221;65px&#8221;]<h1 id=\"u127839-2\" class=\"shared_content\" data-content-guid=\"u127839-2_content\" style=\"text-align: center;\"><span class=\"H1-Jenna-Sue-56pt-zwart\" id=\"u127839\">Bach Bloesem remedies<\/span><\/h1>\n<p id=\"u127839-4\" class=\"shared_content\" data-content-guid=\"u127839-4_content\">Bach bloesems zijn vloeibare extracten van bomen, struiken en planten die positief inwerken op emoties. Ze hebben de eigenschap om negatieve emoties om te buigen naar het positieve. Het is vanwege die eigenschap dat ik ze kan gebruiken als ondersteunend middel na een sessie.<\/p>\n<p class=\"shared_content\" data-content-guid=\"u127839-4_content\"><img loading=\"lazy\" decoding=\"async\" src=\"https:\/\/praktijkannemieke.nl\/site\/wp-content\/uploads\/2021\/06\/annemieke-bachbloesem.jpg\" width=\"329\" height=\"219\" alt=\"\" class=\"wp-image-62 alignnone size-full\" srcset=\"https:\/\/praktijkannemieke.nl\/site\/wp-content\/uploads\/2021\/06\/annemieke-bachbloesem.jpg 329w, https:\/\/praktijkannemieke.nl\/site\/wp-content\/uploads\/2021\/06\/annemieke-bachbloesem-300x200.jpg 300w\" sizes=\"(max-width: 329px) 100vw, 329px\" \/><\/p>\n<p id=\"u127839-12\" class=\"shared_content\" data-content-guid=\"u127839-12_content\">Bach bloesems zijn veilig voor iedereen. Kleine kinderen, zwangere vrouwen en zelfs dieren.<\/p>\n<p id=\"u127839-14\" class=\"shared_content\" data-content-guid=\"u127839-14_content\">Bach remedies helpen je om de balans te herstellen. Ze zijn veilig en onschadelijk. Er zijn geen bijwerkingen, je kunt niet overdoseren en ze werken niet verslavend. Kan gebruikt worden in combinatie met andere medicatie en behandelvormen, inclusief homeopathie, zonder de werking hiervan te belemmeren.<\/p>[\/et_pb_text][\/et_pb_column][\/et_pb_row][\/et_pb_section][et_pb_section fb_built=&#8221;1&#8243; _builder_version=&#8221;4.9.7&#8243; _module_preset=&#8221;default&#8221;][et_pb_row _builder_version=&#8221;4.9.7&#8243; _module_preset=&#8221;default&#8221; background_color=&#8221;#c1dfe0&#8243; custom_padding=&#8221;50px|50px|50px|50px|true|true&#8221;][et_pb_column type=&#8221;4_4&#8243; _builder_version=&#8221;4.9.7&#8243; _module_preset=&#8221;default&#8221;][et_pb_text _builder_version=&#8221;4.9.7&#8243; _module_preset=&#8221;default&#8221; header_font_size=&#8221;65px&#8221;]<h1 id=\"u127839-2\" class=\"shared_content\" data-content-guid=\"u127839-2_content\" style=\"text-align: center;\"><span class=\"H1-Jenna-Sue-56pt-zwart\" id=\"u127839\">Gelzouten<\/span><\/h1>\n<p id=\"u128265-4\" class=\"shared_content\" data-content-guid=\"u128265-4_content\">Als ondersteunende remedie kan er een celzout geadviseerd worden.<\/p>\n<p id=\"u128265-7\" class=\"shared_content\" data-content-guid=\"u128265-7_content\">Celzouten zijn lichaamseigen, minerale zouten zoals ze in het lichaam voorkomen. Bij een tekort aan een bepaald zout kunnen gezondheidsklachten ontstaan. Deze zijn vaak chronisch en kunnen zowel lichamelijk als geestelijke klachten zijn.<\/p>\n<p id=\"u128265-10\" class=\"shared_content\" data-content-guid=\"u128265-10_content\">De celzouten zijn geen medicijnen of homeopathische geneesmiddelen. Het zijn gewreven mineralen die niet geschud zijn zoals dit gebeurt bij homeopathische middelen.<\/p>\n<p class=\"shared_content\" data-content-guid=\"u127839-4_content\"><img loading=\"lazy\" decoding=\"async\" src=\"https:\/\/praktijkannemieke.nl\/site\/wp-content\/uploads\/2021\/06\/1409044_m.jpg\" width=\"329\" height=\"219\" alt=\"\" class=\"wp-image-63 alignnone size-full\" srcset=\"https:\/\/praktijkannemieke.nl\/site\/wp-content\/uploads\/2021\/06\/1409044_m.jpg 329w, https:\/\/praktijkannemieke.nl\/site\/wp-content\/uploads\/2021\/06\/1409044_m-300x200.jpg 300w\" sizes=\"(max-width: 329px) 100vw, 329px\" \/><\/p>\n<p id=\"u128265-17\" class=\"shared_content\" data-content-guid=\"u128265-17_content\">Homeopathische geneesmiddelen geven een prikkel af aan het lichaam en zetten zo het lichaam aan tot actie. Celzouten doen dat niet. Zij ondersteunen slechts de processen van het lichaam.<\/p>\n<p id=\"u128265-19\" class=\"shared_content\" data-content-guid=\"u128265-19_content\">Doordat het geen medicijnen is, kunnen ze zonder problemen gecombineerd worden met andere vormen van medicatie en\/of supplementen. Het is wel zo dat door de celzouten \u2018andere\u2019 medicijnen en supplementen sterker kunnen gaan werken, omdat het lichaam ze beter zal opnemen.<\/p>[\/et_pb_text][\/et_pb_column][\/et_pb_row][\/et_pb_section][et_pb_section fb_built=&#8221;1&#8243; disabled_on=&#8221;off|off|off&#8221; _builder_version=&#8221;4.9.7&#8243; _module_preset=&#8221;default&#8221; background_color=&#8221;#f3f9f9&#8243; custom_padding=&#8221;|3px||||&#8221; global_module=&#8221;94&#8243; saved_tabs=&#8221;all&#8221;][et_pb_row column_structure=&#8221;1_4,1_4,1_4,1_4&#8243; _builder_version=&#8221;4.9.7&#8243; _module_preset=&#8221;default&#8221;][et_pb_column type=&#8221;1_4&#8243; _builder_version=&#8221;4.9.7&#8243; _module_preset=&#8221;default&#8221;][et_pb_text _builder_version=&#8221;4.9.10&#8243; _module_preset=&#8221;default&#8221; text_font_size=&#8221;13px&#8221; header_font_size=&#8221;45px&#8221; header_3_font_size=&#8221;40px&#8221;]<div class=\"MenuItemLabel clearfix grpelem\" id=\"u1890-4\" data-ibe-flags=\"txtStyleSrc\" data-sizepolicy=\"fixed\" data-pintopage=\"page_fixedLeft\">\n<h3 class=\"shared_content\" data-content-guid=\"u1890-4_0_content\">Annemieke<\/h3>\n<p><a href=\"https:\/\/www.praktijkannemieke.nl\/over-annemieke\/\">Over Annemieke<\/a><\/p>\n<p><a href=\"https:\/\/www.praktijkannemieke.nl\/#Wie\">Voor wie<\/a><\/p>\n<p><a href=\"https:\/\/www.praktijkannemieke.nl\/over-annemieke\/#Ervaringen\">Ervaringen<\/a><\/p>\n<\/div>[\/et_pb_text][et_pb_divider color=&#8221;#000000&#8243; disabled_on=&#8221;on|on|off&#8221; _builder_version=&#8221;4.9.10&#8243; _module_preset=&#8221;default&#8221; custom_margin=&#8221;|-250px|||false|false&#8221; custom_padding=&#8221;60px||||false|false&#8221;][\/et_pb_divider][et_pb_text _builder_version=&#8221;4.9.10&#8243; _module_preset=&#8221;default&#8221; text_font_size=&#8221;13px&#8221;]<p><a href=\"https:\/\/praktijkannemieke.nl\/wp-content\/uploads\/2021\/06\/intakeformulier-nei-coaching-en-therapie.docx\" target=\"_blank\" rel=\"noopener\">Intakeformulier (Word)<\/a><\/p>\n<p><a href=\"https:\/\/praktijkannemieke.nl\/wp-content\/uploads\/2021\/06\/betalingsvoorwaarden_annemieke-10-2017.pdf\" target=\"_blank\" rel=\"noopener\">Betalingsvoorwaarden (PDF)<\/a><\/p>[\/et_pb_text][et_pb_text disabled_on=&#8221;on|off|off&#8221; _builder_version=&#8221;4.9.7&#8243; _module_preset=&#8221;default&#8221; text_font_size=&#8221;13px&#8221; custom_margin=&#8221;|-250px|||false|false&#8221; custom_margin_tablet=&#8221;-75px||||false|false&#8221; custom_margin_phone=&#8221;-75px|0px|||false|false&#8221; custom_margin_last_edited=&#8221;on|tablet&#8221;]<p><span>Belangrijk! Ik ben geen arts en stel geen diagnoses. Samen kijken we welke blokkades er zijn en kunnen we deze opruimen om de balans te herstellen. Altijd vanuit je eigen vraag en met respect voor jouw proces. Je blijft zelf verantwoordelijk voor dit proces \u00e9n je gezondheid. Ik zal dan ook nooit afraden om een arts of andere hulpverlener te raadplegen. Uiteraard is privacy gegarandeerd.<\/span><\/p>[\/et_pb_text][\/et_pb_column][et_pb_column type=&#8221;1_4&#8243; _builder_version=&#8221;4.9.7&#8243; _module_preset=&#8221;default&#8221;][et_pb_text _builder_version=&#8221;4.9.10&#8243; _module_preset=&#8221;default&#8221; text_font_size=&#8221;13px&#8221; header_font_size=&#8221;40px&#8221; header_3_font_size=&#8221;40px&#8221;]<h3 class=\"shared_content\" data-content-guid=\"u1890-4_0_content\">Wat ik doe<\/h3>\n<p><a href=\"https:\/\/www.praktijkannemieke.nl\/#Nei\">NEI-therapie<\/a><\/p>\n<p><a href=\"https:\/\/www.praktijkannemieke.nl\/shambhala-reiki\/\">Shambhala Reiki<\/a><\/p>\n<p><a href=\"https:\/\/www.praktijkannemieke.nl\/ondersteunende-middelen\/\">Ondersteunende middelen<\/a><\/p>\n<p><a href=\"https:\/\/www.praktijkannemieke.nl\/access-bars\/\">Access Bars<\/a><\/p>[\/et_pb_text][et_pb_button button_url=&#8221;https:\/\/www.praktijkannemieke.nl\/site\/neem-contact-op\/&#8221; button_text=&#8221;NEEM CONTACT OP&#8221; _builder_version=&#8221;4.9.7&#8243; _module_preset=&#8221;default&#8221; custom_button=&#8221;on&#8221; button_text_size=&#8221;13px&#8221; button_border_width=&#8221;1px&#8221; button_border_color=&#8221;#f6d9db&#8221; button_font=&#8221;|600|||||||&#8221; button_use_icon=&#8221;off&#8221; custom_margin=&#8221;||||false|false&#8221; custom_padding=&#8221;10px|20px|10px|20px|false|false&#8221; button_bg_color__hover_enabled=&#8221;on|desktop&#8221; button_bg_color__hover=&#8221;#FFFFFF&#8221; button_bg_enable_color__hover=&#8221;on&#8221; button_border_width__hover_enabled=&#8221;on|hover&#8221; button_border_color__hover_enabled=&#8221;on|hover&#8221;][\/et_pb_button][\/et_pb_column][et_pb_column type=&#8221;1_4&#8243; _builder_version=&#8221;4.9.7&#8243; _module_preset=&#8221;default&#8221;][et_pb_text _builder_version=&#8221;4.9.10&#8243; _module_preset=&#8221;default&#8221; text_font_size=&#8221;13px&#8221; header_font_size=&#8221;45px&#8221; header_3_font_size=&#8221;40px&#8221;]<h3 class=\"shared_content\" data-content-guid=\"u1890-4_0_content\">Werkwijze<\/h3>\n<p class=\"body\" id=\"u86998-12\"><span class=\"shared_content\" data-content-guid=\"u86998-12_0_content\">Door het<span>\u00a0<\/span><\/span><strong><a class=\"nonblock\" href=\"https:\/\/praktijkannemieke.nl\/assets\/intakeformulier-nei-coaching-en-therapie.docx\" data-href=\"upload:U87056\" target=\"_blank\" rel=\"noopener\"><span id=\"u86998-4\" class=\"shared_content\" data-content-guid=\"u86998-4_content\">intakeformulier<\/span><\/a><\/strong><span class=\"shared_content\" data-content-guid=\"u86998-12_2_content\"><span>\u00a0<\/span>in te vullen en dit te mailen naar<span> <span id=\"u2146-8\"><a href=\"mailto:welkom@praktijkannemieke.nl\">welkom@praktijkannemieke.nl<\/a><\/span><\/span><\/span><span class=\"shared_content\" data-content-guid=\"u86998-12_4_content\">, kan tijdens de eerste afspraak direct worden gestart met de hulpvraag.<\/span><\/p>\n<p class=\"body shared_content\" id=\"u86998-13\" data-content-guid=\"u86998-13_content\">\u00a0De praktijk wijst uit dat er na enkele afspraken al veel verandert in de situatie. Aan het eind van iedere sessie wordt besproken of een nieuwe afspraak wenselijk is.<\/p>\n<p class=\"body shared_content\" id=\"u86998-16\" data-content-guid=\"u86998-16_content\">\u00a0De praktijk is op alle werkdagen geopend. Avond afspraken kunnen in overleg gepland worden.<\/p>\n<p class=\"body shared_content\" id=\"u86998-19\" data-content-guid=\"u86998-19_content\">\u00a0Lees onze<span>\u00a0<\/span><strong><a class=\"nonblock\" href=\"https:\/\/praktijkannemieke.nl\/privacyverklaring\/\" data-href=\"page:U204968\"><span id=\"u86998-21\">privacyverklaring.<\/span><\/a><\/strong><\/p>\n<h3 class=\"body shared_content\" id=\"u86998-25\" data-content-guid=\"u86998-25_content\"><span class=\"H1-Jenna-Sue-56pt-zwart\" id=\"u86998-26\">Tarief<\/span><\/h3>\n<p class=\"body shared_content\" id=\"u86998-29\" data-content-guid=\"u86998-29_content\">De kosten bedragen \u20ac85,- voor een NEI sessie, \u20ac65,- voor een Reiki behandeling en \u20ac65,- voor een Access Bars behandeling.<\/p>[\/et_pb_text][\/et_pb_column][et_pb_column type=&#8221;1_4&#8243; _builder_version=&#8221;4.9.7&#8243; _module_preset=&#8221;default&#8221;][et_pb_text _builder_version=&#8221;4.9.7&#8243; _module_preset=&#8221;default&#8221; text_font_size=&#8221;13px&#8221;]<p><img loading=\"lazy\" decoding=\"async\" src=\"https:\/\/praktijkannemieke.nl\/site\/wp-content\/uploads\/2021\/07\/logo-annemieke.png\" width=\"437\" height=\"323\" alt=\"\" class=\"wp-image-409 alignnone size-full\" srcset=\"https:\/\/praktijkannemieke.nl\/site\/wp-content\/upload